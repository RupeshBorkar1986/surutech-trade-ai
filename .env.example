PORT=3000

# Optional key used to protect SuruTech Trade AI's own local HTTP API.
# This is NOT your Zerodha API key.
API_KEY=

# Zerodha Kite Connect credentials.
# Keep these only in your local .env file. Never commit real values to GitHub.
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://localhost:3000/auth/zerodha/callback

# Optional: leave blank. The app should create/update this after Zerodha login.
KITE_ACCESS_TOKEN=

DEFAULT_SYMBOL=NIFTY
STRIKE_STEP=50
LOT_SIZE=65
MAX_RISK_PCT=0.005
MAX_DAILY_LOSS_PCT=0.02
MAX_TRADES_PER_DAY=5
COOLDOWN_MINUTES=10

# Live order execution is intentionally not implemented in this MVP.
